{
  "name": "mamyr-altaibek-academic-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node scripts/render-site.mjs && vite --host 127.0.0.1",
    "build": "node scripts/render-site.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint src scripts tests vite.config.ts playwright.config.ts && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "metrics:update": "node scripts/update-metrics.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.39.0",
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/newsreader": "^5.2.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0"
  }
}
